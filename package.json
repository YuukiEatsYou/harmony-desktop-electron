{
  "name": "harmony",
  "productName": "Harmony",
  "desktopName": "harmony.desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop client for Harmony, connecting to many self-hosted servers at once.",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "YuukiEatsYou",
    "email": "heinrichtester4@gmail.com"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron scripts/smoke.js",
    "test": "node scripts/store-test.js && node scripts/harmony-test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.harmony.Harmony",
    "productName": "Harmony",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "synopsis": "Multi-server desktop client for Harmony",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking"
    }
  }
}
